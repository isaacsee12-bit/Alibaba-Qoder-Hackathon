# Server port (default 3000)
PORT=3000

# Optional SQLite database file path (default backend/db/food.db).
# Set this to a folder outside OneDrive if you hit SQLITE_BUSY / file-lock errors.
DB_PATH=

# Optional server-wide provider keys. A browser-connected key takes priority.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional provider preference when both server keys are configured.
AI_PROVIDER=openai

# Optional model overrides.
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Required to encrypt API keys entered through the Settings tab.
# Use a randomly generated value with at least 32 characters and keep it secret.
APP_ENCRYPTION_SECRET=

# Backward-compatible aliases.
LLM_API_KEY=
GOOGLE_API_KEY=
