# Server port (default 3000)
PORT=3000

# Optional SQLite database file path (default backend/db/food.db).
# Set this to a folder outside OneDrive if you hit SQLITE_BUSY / file-lock errors.
DB_PATH=

# Optional LLM API key for AI-powered recipe suggestions and diet advice.
# Leave empty to use the built-in rule-based engine (services/llmClient.js
# returns null when no key is set, so everything works without it).
LLM_API_KEY=
