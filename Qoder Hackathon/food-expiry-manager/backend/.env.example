# Server port (default 3000)
PORT=3000

# Optional SQLite database file path (default backend/db/food.db).
# Set this to a folder outside OneDrive if you hit SQLITE_BUSY / file-lock errors.
DB_PATH=

# Optional server-wide OpenAI key. The browser-connected key takes priority when present.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

# Required to encrypt API keys entered through the Settings tab.
# Use a randomly generated value with at least 32 characters and keep it secret.
APP_ENCRYPTION_SECRET=

# Backward-compatible alias for a server-wide OpenAI key.
LLM_API_KEY=
